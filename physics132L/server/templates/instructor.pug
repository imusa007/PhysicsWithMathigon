extends ../../node_modules/@mathigon/studio/server/templates/_layout.pug

block vars
  - var title = 'Instructor — Student progress'
  - var styles = ['/main.css']

block main
  .container(style="max-width: 900px; margin: 2rem auto;")
    h1 Instructor — Student progress
    p
      | Students who have started at least one module. Download
      = ' '
      a(href="/instructor/export") CSV
      = ' '
      | or
      = ' '
      a(href="/instructor/export?format=json") JSON
      = ' '
      | for grading.
    if students.length === 0
      p No student progress yet.
    else
      table(style="width: 100%; border-collapse: collapse; margin-top: 1rem;")
        thead
          tr(style="border-bottom: 2px solid #ddd;")
            th(style="text-align: left; padding: 0.5rem;") Student
            th(style="text-align: left; padding: 0.5rem;") Email
            th(style="text-align: left; padding: 0.5rem;") Modules
            th(style="text-align: right; padding: 0.5rem;") Progress
            th(style="text-align: right; padding: 0.5rem;") Points
            th(style="text-align: right; padding: 0.5rem;") Attempts
            th(style="text-align: center; padding: 0.5rem;") Struggle
        tbody
          for s in students
            tr(style="border-bottom: 1px solid #eee;")
              td(style="padding: 0.5rem;")
                strong= (s.user.firstName || '') + ' ' + (s.user.lastName || '')
              td(style="padding: 0.5rem;")= s.user.email || '—'
              td(style="padding: 0.5rem;")
                for c in s.courses
                  span(style="display: inline-block; margin-right: 0.5rem;")= c.courseId
              td(style="padding: 0.5rem; text-align: right;")
                for c in s.courses
                  span(style="display: inline-block; margin-left: 0.5rem;")= c.progress + '%'
              td(style="padding: 0.5rem; text-align: right;")
                for c in s.courses
                  span(style="display: inline-block; margin-left: 0.5rem;")= c.points != null ? c.points : '—'
              td(style="padding: 0.5rem; text-align: right;")
                for c in s.courses
                  span(style="display: inline-block; margin-left: 0.5rem;")= c.attempts != null ? c.attempts : '—'
              td(style="padding: 0.5rem; text-align: center;")
                for c in s.courses
                  span(style="display: inline-block; margin-left: 0.25rem;")= c.struggle ? 'Y' : '—'
