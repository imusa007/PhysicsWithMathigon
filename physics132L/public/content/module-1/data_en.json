{"id":"module-1","locale":"en","nextCourse":"module-2","prevCourse":"module-2","title":"Module 1 — Vectors","description":"Case Study 1, Case Study 2, Lab, Homework. Vector addition, dot and cross product.","color":"#1565C0","hero":"/content/module-1/hero.jpg","goals":20,"sections":[{"id":"intro","title":"What is a Vector?","url":"/course/module-1/intro","steps":["intro-slider"],"goals":2,"duration":5},{"id":"addition","title":"Vector Addition","url":"/course/module-1/addition","steps":["addition-interactive","addition-quiz"],"goals":6,"duration":5},{"id":"subtraction","title":"Vector Subtraction","url":"/course/module-1/subtraction","steps":["sub-interactive"],"goals":4,"duration":5},{"id":"dot-product","title":"Dot Product","url":"/course/module-1/dot-product","steps":["dot-interactive"],"goals":4,"duration":5},{"id":"cross-product","title":"Cross Product","url":"/course/module-1/cross-product","steps":["cross-interactive"],"goals":4,"duration":5},{"id":"summary","title":"Summary","url":"/course/module-1/summary","steps":["summary-1"],"goals":0,"duration":5}],"steps":{"intro-slider":{"id":"intro-slider","title":"Intro Slider","html":"<x-step id=\"intro-slider\" goals=\"var-0 var-1\"><p>A <strong>vector</strong> has magnitude and direction. Set components: x = <span class=\"nowrap\"><x-var bind=\"vx|3|-5,5,1\" goal=\"var-0\">${vx}</x-var>,</span> y = <x-var bind=\"vy|2|-5,5,1\" goal=\"var-1\">${vy}</x-var></p><p>Magnitude ≈ <strong><span class=\"var\">${round(sqrt(vx*vx + vy*vy), 2)}</span></strong></p><figure><svg id=\"vector-intro\" width=\"340\" height=\"340\"></svg></figure></x-step>","goals":["var-0","var-1"],"keywords":[]},"addition-interactive":{"id":"addition-interactive","title":"Addition Interactive","html":"<x-step id=\"addition-interactive\" goals=\"var-0 var-1 var-2 var-3\"><p><strong>a</strong>: x = <span class=\"nowrap\"><x-var bind=\"ax|2|-4,4,1\" goal=\"var-0\">${ax}</x-var>,</span> y = <x-var bind=\"ay|1|-4,4,1\" goal=\"var-1\">${ay}</x-var> &nbsp;&nbsp; <strong>b</strong>: x = <span class=\"nowrap\"><x-var bind=\"bx|1|-4,4,1\" goal=\"var-2\">${bx}</x-var>,</span> y = <x-var bind=\"by|3|-4,4,1\" goal=\"var-3\">${by}</x-var></p><p><strong>a + b</strong> = (<span class=\"var\">${ax+bx}</span>, <span class=\"var\">${ay+by}</span>)</p><figure><svg id=\"vector-add\" width=\"340\" height=\"340\"></svg></figure></x-step>","goals":["var-0","var-1","var-2","var-3"],"keywords":[]},"addition-quiz":{"id":"addition-quiz","title":"Addition Quiz","html":"<x-step id=\"addition-quiz\" goals=\"blank-0 blank-1\"><p><strong>Practice:</strong> What is (2,3) + (8,7)? Enter the two components.</p><p><strong>(2,3) + (8,7) = ( <span class=\"nowrap\"><x-blank solution=\"10\" goal=\"blank-0\"></x-blank>,</span> <x-blank solution=\"10\" goal=\"blank-1\"></x-blank> )</strong></p></x-step>","goals":["blank-0","blank-1"],"keywords":[]},"sub-interactive":{"id":"sub-interactive","title":"Sub Interactive","html":"<x-step id=\"sub-interactive\" goals=\"var-0 var-1 var-2 var-3\"><p><strong>a</strong>: x = <span class=\"nowrap\"><x-var bind=\"ax2|3|-4,4,1\" goal=\"var-0\">${ax2}</x-var>,</span> y = <x-var bind=\"ay2|2|-4,4,1\" goal=\"var-1\">${ay2}</x-var> &nbsp;&nbsp; <strong>b</strong>: x = <span class=\"nowrap\"><x-var bind=\"bx2|1|-4,4,1\" goal=\"var-2\">${bx2}</x-var>,</span> y = <x-var bind=\"by2|3|-4,4,1\" goal=\"var-3\">${by2}</x-var></p><p><strong>a − b</strong> = (<span class=\"var\">${ax2-bx2}</span>, <span class=\"var\">${ay2-by2}</span>)</p><figure><svg id=\"vector-sub\" width=\"340\" height=\"340\"></svg></figure></x-step>","goals":["var-0","var-1","var-2","var-3"],"keywords":[]},"dot-interactive":{"id":"dot-interactive","title":"Dot Interactive","html":"<x-step id=\"dot-interactive\" goals=\"var-0 var-1 var-2 var-3\"><p><strong>a</strong>: x = <span class=\"nowrap\"><x-var bind=\"dax|3|-4,4,1\" goal=\"var-0\">${dax}</x-var>,</span> y = <x-var bind=\"day|1|-4,4,1\" goal=\"var-1\">${day}</x-var> &nbsp;&nbsp; <strong>b</strong>: x = <span class=\"nowrap\"><x-var bind=\"dbx|1|-4,4,1\" goal=\"var-2\">${dbx}</x-var>,</span> y = <x-var bind=\"dby|2|-4,4,1\" goal=\"var-3\">${dby}</x-var></p><p><strong>a · b</strong> = <span class=\"var\">${dax*dbx + day*dby}</span> &nbsp;&nbsp; Angle ≈ <strong><span class=\"var\">${round(acos(max(-1,min(1,(dax*dbx+day*dby)/(max(0.01,sqrt(dax*dax+day*day))*max(0.01,sqrt(dbx*dbx+dby*dby))))))*180/pi, 1)}</span>°</strong></p><figure><svg id=\"vector-dot\" width=\"340\" height=\"340\"></svg></figure></x-step>","goals":["var-0","var-1","var-2","var-3"],"keywords":[]},"cross-interactive":{"id":"cross-interactive","title":"Cross Interactive","html":"<x-step id=\"cross-interactive\" goals=\"var-0 var-1 var-2 var-3\"><p><strong>a</strong>: x = <span class=\"nowrap\"><x-var bind=\"cax|3|-4,4,1\" goal=\"var-0\">${cax}</x-var>,</span> y = <x-var bind=\"cay|1|-4,4,1\" goal=\"var-1\">${cay}</x-var> &nbsp;&nbsp; <strong>b</strong>: x = <span class=\"nowrap\"><x-var bind=\"cbx|1|-4,4,1\" goal=\"var-2\">${cbx}</x-var>,</span> y = <x-var bind=\"cby|2|-4,4,1\" goal=\"var-3\">${cby}</x-var></p><p><strong>a × b</strong> = <span class=\"var\">${cax*cby - cay*cbx}</span> &nbsp;&nbsp; Parallelogram area = <strong><span class=\"var\">${abs(cax*cby - cay*cbx)}</span></strong> sq units</p><figure><svg id=\"vector-cross\" width=\"340\" height=\"340\"></svg></figure></x-step>","goals":["var-0","var-1","var-2","var-3"],"keywords":[]},"summary-1":{"id":"summary-1","title":"Summary  ","html":"<x-step id=\"summary-1\" goals=\"\"><table> <thead> <tr> <th>Operation</th><th>Formula</th><th>Result Type</th></tr> </thead> <tbody><tr> <td>Addition</td><td>(a_x+b_x, a_y+b_y)</td><td>Vector</td></tr> <tr> <td>Subtraction</td><td>(a_x−b_x, a_y−b_y)</td><td>Vector</td></tr> <tr> <td>Dot Product</td><td>a_x·b_x + a_y·b_y</td><td>Scalar</td></tr> <tr> <td>Cross Product</td><td>a_x·b_y − a_y·b_x</td><td>Scalar (2D)</td></tr> </tbody></table> </x-step>","goals":[],"keywords":[]}},"availableLocales":["en"],"biosJSON":"{}","glossJSON":"{}","hintsJSON":"{}"}